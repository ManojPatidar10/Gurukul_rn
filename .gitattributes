# The website build (website/build.py) writes docs/ with LF line endings. Checking docs/ and website/
# out with LF too means a rebuild on Windows (core.autocrlf=true) leaves git status clean.
docs/** text=auto eol=lf
website/** text=auto eol=lf
# Images and fonts (the Open Graph cards and website/og/) are binary: never diffed or line-converted.
*.png binary
*.ttf binary
