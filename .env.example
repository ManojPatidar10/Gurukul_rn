# Copy to `.env` (gitignored) for local development.
#
# EXPO_PUBLIC_* variables are inlined into the compiled bundle and are readable by anyone with the
# APK. Never put a credential here - no API keys, no AWS keys, no secrets of any kind. The AI
# features (Academic Helper, and the Helpdesk bot) all call our own backend, which holds the real
# provider credentials server-side and never ships them to the phone.
#
# Changing this file requires restarting Metro with a cleared cache (`npx expo start -c`), because
# the values are baked in at bundle time rather than read at runtime.

# Point the app at a backend other than production (https://api.smartgurukul.org).
# Android emulator  -> the host machine is 10.0.2.2, NOT localhost (localhost is the emulator itself)
# iOS simulator     -> http://localhost:8080 works
# Physical device   -> your machine's LAN IP, e.g. http://192.168.1.20:8080, on the same Wi-Fi
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
