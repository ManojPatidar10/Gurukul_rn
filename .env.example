# Amazon Bedrock configuration for the Academic Helper feature.
# Copy this file to `.env` and fill in your own values. `.env` is gitignored.
#
# SECURITY WARNING: these EXPO_PUBLIC_* variables are bundled directly into
# the compiled app and are extractable by anyone who has the app binary or
# inspects its network traffic. Only use an IAM user/key that is restricted
# to bedrock:InvokeModel on the specific model(s) below, nothing else, and
# set a billing alarm on this AWS account.

EXPO_PUBLIC_AWS_REGION=us-east-1
EXPO_PUBLIC_AWS_ACCESS_KEY_ID=
EXPO_PUBLIC_AWS_SECRET_ACCESS_KEY=
EXPO_PUBLIC_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
