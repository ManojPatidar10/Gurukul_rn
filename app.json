{
  "expo": {
    "name": "Gurukul_rn",
    "slug": "gurukul-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gurukul.rn",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["upi", "phonepe", "gpay"]
      }
    },
    "android": {
      "package": "com.gurukul.rn",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Gurukul uses your camera for video calls."
        }
      ],
      [
        "expo-av",
        { "microphonePermission": "Gurukul uses your microphone for video calls." }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Gurukul uses your location to confirm you're at the school when self-marking attendance."
        }
      ],
      "expo-font",
      "expo-notifications",
      "./plugins/withCleartextTraffic.js",
      "./plugins/withUpiIntentQueries.js",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "f610c224-f96d-4706-a22c-38f27170b00c"
      }
    },
    "owner": "yashcodes105"
  }
}
